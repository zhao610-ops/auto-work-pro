# 权限：chmod 600 /etc/trendpublish/toutiao-relay.env
TOUTIAO_RELAY_PORT=8091
TOUTIAO_RELAY_TOKEN=必须与main.env中的TOUTIAO_RELAY_TOKEN一致
TOUTIAO_PROFILE_DIR=/opt/ai-trend-publish/data/toutiao/browser-data
TOUTIAO_SCREENSHOTS_DIR=/opt/ai-trend-publish/data/toutiao/screenshots
TOUTIAO_STATE_PATH=/opt/ai-trend-publish/data/toutiao/article-records.json
TOUTIAO_HEADLESS=true
TOUTIAO_CHROME_CHANNEL=chrome
